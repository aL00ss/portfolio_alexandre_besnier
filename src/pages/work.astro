---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';

const projects = (await getCollection('work')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// collect all unique tags
const allTags = Array.from(
  new Set(projects.flatMap((p) => p.data.tags ?? []))
).sort();
---
<BaseLayout
  title="Mes Projets | Alexandre Besnier"
  description="Découvrez mes projets universitaires récents"
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title="Mes Projets"
        tagline="Consultez mes projets les plus récents ci-dessous pour avoir une idée de mon expérience passée."
        align="start"
      />

      <!-- Custom tag‐filter UI -->
      <div class="filter-bar">
        <div class="selected-tags"></div>
        <button class="tag-dropdown-button" type="button">
          Filtrer par tags ▾
        </button>
        <ul class="tag-dropdown-list">
          {allTags.map((tag) => (
            <li data-tag={tag}>{tag}</li>
          ))}
        </ul>
      </div>

      <!-- Projects Grid -->
      <Grid variant="offset">
        {projects.map((project) => (
          <li data-tags={(project.data.tags ?? []).join(',')}>
            <PortfolioPreview project={project} />
          </li>
        ))}
      </Grid>
    </main>

    <ContactCTA />
  </div>

  <!-- Client‐side script to manage dropdown, pills & filtering -->
  <script type="module" client:load>
    document.addEventListener('DOMContentLoaded', () => {
      const dropdownBtn = document.querySelector('.tag-dropdown-button');
      const dropdown    = document.querySelector('.tag-dropdown-list');
      const selected    = document.querySelector('.selected-tags');
      const cards       = document.querySelectorAll('li[data-tags]');

      // toggle dropdown
      dropdownBtn.addEventListener('click', () => {
        dropdown.classList.toggle('visible');
      });

      // click outside to close
      document.addEventListener('click', e => {
        if (!dropdown.contains(e.target) && e.target !== dropdownBtn) {
          dropdown.classList.remove('visible');
        }
      });

      // add tag‐pill on click
      dropdown.querySelectorAll('li').forEach(item => {
        item.addEventListener('click', () => {
          const tag = item.dataset.tag;
          // if not already selected
          if (!selected.querySelector(`[data-tag="${tag}"]`)) {
            const pill = document.createElement('span');
            pill.className = 'tag-pill';
            pill.dataset.tag = tag;
            pill.innerHTML = `
              ${tag}
              <button type="button" class="remove-pill">×</button>
            `;
            selected.append(pill);
            updateFilter();
          }
        });
      });

      // remove pill and refilter
      selected.addEventListener('click', e => {
        if (e.target.classList.contains('remove-pill')) {
          const pill = e.target.closest('.tag-pill');
          pill.remove();
          updateFilter();
        }
      });

      function updateFilter() {
        const activeTags = Array.from(
          selected.querySelectorAll('.tag-pill')
        ).map(p => p.dataset.tag);

        cards.forEach(card => {
          const tags = card.dataset.tags.split(',');
          const show = activeTags.every(t => tags.includes(t));
          card.style.display = show ? '' : 'none';
        });
      }
    });
  </script>

  <style>
    .filter-bar {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 1.5rem 0;
    }
    .selected-tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .tag-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      background: var(--accent-subtle);
      color: var(--text);
      padding: 0.2rem 0.6rem;
      border-radius: 1rem;
      font-size: 0.875rem;
    }
    .tag-pill .remove-pill {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;
      color: var(--text-muted);
    }
    .tag-dropdown-button {
      cursor: pointer;
      padding: 0.4rem 0.8rem;
      font-size: 1rem;
      border: 1px solid var(--gray-500);
      border-radius: 0.25rem;
      background: var(--bg-paper);
    }
    .tag-dropdown-list {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 100;
      list-style: none;
      margin: 0.25rem 0 0;
      padding: 0.5rem 0;
      background: var(--bg-paper);
      border: 1px solid var(--gray-400);
      border-radius: 0.25rem;
      max-height: 12rem;
      overflow-y: auto;
      display: none;
      width: max-content;
      min-width: 8rem;
    }
    .tag-dropdown-list.visible {
      display: block;
    }
    .tag-dropdown-list li {
      padding: 0.3rem 0.8rem;
      cursor: pointer;
      white-space: nowrap;
    }
    .tag-dropdown-list li:hover {
      background: var(--accent-subtle-over);
    }
  </style>
</BaseLayout>
